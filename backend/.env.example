# Copy this file to .env and adjust as needed.
# Nothing here is required to run the app in demo mode -- see DEMO_MODE below.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME="Itinero"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# If you run several local projects at once and hit port collisions,
# change this (and the matching port in docker-compose.yml / your frontend
# .env) rather than fighting with whatever else is bound to 8000.
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate a real value for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost:5173","http://localhost:5183"]

# ---------------------------------------------------------------------------
# Database (docker-compose sets this for you when running via Compose)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://trip_planner:trip_planner_dev@localhost:5432/trip_planner

# ---------------------------------------------------------------------------
# Redis (cache + live-progress pub/sub)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# When true (the default), every travel-data provider AND the LLM
# reasoning layer itself run on deterministic mock logic -- the entire
# agentic workflow, including the critic/replanning loop, works with zero
# API keys. Set to false once you've configured a real LLM_PROVIDER (and
# optionally real travel providers below) to use them instead.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# LLM provider (only matters once DEMO_MODE=false)
# ---------------------------------------------------------------------------
# One of: openai | anthropic | google | openrouter | mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Travel data providers (mock-by-default; each has a real adapter you can
# switch on independently of the others -- see docs/providers.md)
# ---------------------------------------------------------------------------
FLIGHTS_PROVIDER=mock          # mock | amadeus
HOTELS_PROVIDER=mock           # mock | booking
PLACES_PROVIDER=mock           # mock | google_places
WEATHER_PROVIDER=mock          # mock | open_meteo   (open_meteo needs no key)
CURRENCY_PROVIDER=mock         # mock | exchange_rate_api
WEB_SEARCH_PROVIDER=mock       # mock | tavily

AMADEUS_API_KEY=
AMADEUS_API_SECRET=
GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Agent cost / safety controls
# ---------------------------------------------------------------------------
MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS=40
MAX_LLM_COST_USD=2.00
MAX_TRIP_PLANNING_TIME_SECONDS=180

# ---------------------------------------------------------------------------
# Cache TTLs (seconds)
# ---------------------------------------------------------------------------
CACHE_TTL_WEATHER=3600
CACHE_TTL_CURRENCY=3600
CACHE_TTL_PLACES=86400
CACHE_TTL_FLIGHTS=900
CACHE_TTL_HOTELS=900

# Authentication
# Secret key used for JWT signing and OAuth cookies (should be a secure random string)
SECRET_KEY="replace_me_with_a_secure_random_string_in_production"

# LLM Providers (Required if not using DEMO_MODE)
# Example failover chain: ["nvidia", "openrouter", "groq", "google"]
LLM_PROVIDER_CHAIN=["mock"]
LLM_MODEL_CHEAP="nvidia/nemotron-3-super-120b-a12b"
LLM_MODEL_HEAVY="nvidia/nemotron-3.5-lightning:free"
LLM_DAILY_CAP_GROQ=14000
LLM_DAILY_CAP_GOOGLE=1500
LLM_DAILY_CAP_OPENROUTER=0
LLM_DAILY_CAP_NVIDIA=0

# API Keys for LLM Providers
GROQ_API_KEY=""
NVIDIA_API_KEY=""
GOOGLE_API_KEY=""

# Data Providers
FOOD_PROVIDER="tavily_food"
SERPAPI_KEY=""
RAPIDAPI_KEY=""
GEOAPIFY_API_KEY=""

# Architecture
BACKGROUND_EXECUTOR="celery"
CACHE_TTL_LLM=86400
